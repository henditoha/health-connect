# SATUSEHAT Staging / Production Credentials Example
# Salin file ini menjadi .env dan masukkan kredensial faskes Anda
SATUSEHAT_ORG_ID=YOUR_SATUSEHAT_ORG_ID
SATUSEHAT_CLIENT_ID=YOUR_SATUSEHAT_CLIENT_ID
SATUSEHAT_CLIENT_SECRET=YOUR_SATUSEHAT_CLIENT_SECRET
SATUSEHAT_AUTH_URL=https://api-satusehat-stg.kemkes.go.id/oauth2/v1/accesstoken?grant_type=client_credentials
SATUSEHAT_FHIR_URL=https://api-satusehat-stg.kemkes.go.id/fhir-r4/v1
SATUSEHAT_ENV=STAGING
